# Copiar a .env y completar. NUNCA subir .env al repo.

# URL base de la API (sin barra final)
SIGMA_BASE_URL=https://sigma.sig2k.com/pejinakis@sigma/api/v10

# Token de la API (header X-Auth-Token). Generado en SIGMA -> Tokens de API -> Api_Sigma
SIGMA_TOKEN=

# Dónde se guardan los datos (por defecto ./data)
SIGMA_DATA_DIR=./data

# Formato de almacenamiento: parquet (recomendado) o csv
SIGMA_STORE_FORMAT=parquet

# Ventana móvil que se recarga en cada corrida (días hacia atrás).
# Cubre anulaciones y notas de crédito tardías.
SIGMA_WINDOW_DAYS=35

# Días por pedido a la API al cargar rangos largos. IMPORTANTE: la API cobra una espera DESPUÉS de cada
# llamada, proporcional a las filas devueltas (~12 s por cada 1000), y también entre corridas distintas.
# Conviene pocas llamadas grandes, pero la API corta las respuestas de más de ~200 MB (~150.000 ítems):
# 90 días (~80.000 ítems) es seguro; si un tramo igual es muy grande, el ETL lo parte solo.
SIGMA_CHUNK_DAYS=90

# Pausa mínima entre requests (segundos). La API limita la concurrencia (429).
SIGMA_MIN_INTERVAL_S=1.0

# Timeout por request (segundos). Una llamada de ~130.000 ítems tarda ~30 s.
SIGMA_TIMEOUT_S=180

# Paginación por page/pagesize (verificada). Con 200000 por página, cada tramo entra en una llamada.
SIGMA_PAGINATE=true
SIGMA_PAGE_SIZE=200000
