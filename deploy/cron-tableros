# /etc/cron.d/tablero-sigma: ETL de SIGMA. El servidor está en UTC y Argentina es UTC-3 sin horario de verano:
# 09:00 UTC = 06:00 Salta (ETL completo: dimensiones + ventana móvil); 19:00 UTC = 16:00 Salta (solo ventas).
# No se cambia la zona horaria del servidor porque otros tableros pueden depender de ella. El ETL tiene su propio candado (.etl.lock).
SHELL=/bin/bash
0 9  * * * @SVC_USER@ cd @APP_DIR@ && venv/bin/python scripts/etl/run_etl.py >> /var/log/tablero-sigma/etl.log 2>&1
0 19 * * * @SVC_USER@ cd @APP_DIR@ && venv/bin/python scripts/etl/run_etl.py --solo ventas >> /var/log/tablero-sigma/etl.log 2>&1
